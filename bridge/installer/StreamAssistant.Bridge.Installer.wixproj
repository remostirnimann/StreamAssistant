<Project Sdk="WixToolset.Sdk/5.0.2">
  <!--
    Windows installer of the console bridge: a service for all users.
    Not part of the solution (WiX builds on Windows only). Publish the bridge first:

      dotnet publish bridge/src/StreamAssistant.Bridge -c Release -r win-x64 -o publish
      dotnet build bridge/installer -c Release -p:BridgeDir=../../publish/ -p:ProductVersion=0.8.0 -o dist
  -->
  <PropertyGroup>
    <OutputName>stream-assistant-bridge-win-x64</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <BridgeDir Condition="'$(BridgeDir)' == ''">..\..\publish\</BridgeDir>
    <ProductVersion Condition="'$(ProductVersion)' == ''">0.0.1</ProductVersion>
    <DefineConstants>BridgeDir=$(BridgeDir);ProductVersion=$(ProductVersion)</DefineConstants>
    <SuppressIces>ICE61</SuppressIces>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" />
    <PackageReference Include="WixToolset.Firewall.wixext" Version="5.0.2" />
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.2" />
  </ItemGroup>
</Project>
