root = true

[*.cs]
indent_style = space
indent_size = 4
charset = utf-8
insert_final_newline = true
end_of_line = lf

# Source-generated logger methods only pay off for very frequent logging; the bridge logs rarely
dotnet_diagnostic.CA1848.severity = none
dotnet_diagnostic.CA1873.severity = none

[tests/**.cs]
# Test names read as sentences: Key_presses_are_reported
dotnet_diagnostic.CA1707.severity = none
